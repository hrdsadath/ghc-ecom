NODE_ENV=development
HOST=0.0.0.0
PORT=3001
API_BODY_LIMIT=1mb
TRUST_PROXY_HOPS=0
ENABLE_SWAGGER=true
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=35000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
OUTBOUND_TIMEOUT_MS=10000
CSRF_SECRET=replace-with-at-least-32-random-characters
SESSION_REFRESH_TTL_SECONDS=2592000
FRONTEND_ORIGIN=http://localhost:3000
# Optional additional, comma-separated origins permitted to make credentialed browser requests.
# The primary FRONTEND_ORIGIN is always allowed.
FRONTEND_ORIGINS=
# Keep false in production unless you intentionally need a local browser to access the API.
ALLOW_LOCALHOST_CORS_IN_PRODUCTION=false
API_PUBLIC_URL=http://localhost:3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
REDIS_URL=redis://localhost:6379
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Set true only in an isolated production-shaped staging environment using the HDFC sandbox.
ALLOW_TEST_PAYMENTS_IN_PRODUCTION=false
# HDFC SmartGateway (hosted payment page), the only payment gateway. Must be true in production.
HDFC_ENABLED=false
# Sandbox: https://smartgateway.hdfcuat.bank.in  Production: https://smartgateway.hdfc.bank.in
HDFC_BASE_URL=https://smartgateway.hdfcuat.bank.in
HDFC_MERCHANT_ID=
# Dashboard → Payments → Settings → Security → API Keys. Server-side only.
HDFC_API_KEY=
# Sandbox: hdfcmaster. Production: leave empty to use HDFC_MERCHANT_ID.
HDFC_PAYMENT_PAGE_CLIENT_ID=hdfcmaster
# Sent as x-resellerid when set (the docs list hdfc_reseller).
HDFC_RESELLER_ID=hdfc_reseller
# Defaults to FRONTEND_ORIGIN + /checkout/result (must be HTTPS, no query string, no redirect).
HDFC_RETURN_URL=
# Must match Dashboard → Payments → Settings → Webhook. Username: letters and digits only.
HDFC_WEBHOOK_USERNAME=
HDFC_WEBHOOK_PASSWORD=
EMAIL_FROM="Glockery Home Centre <orders@example.com>"
RESEND_API_KEY=replace-with-resend-api-key
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
SHIPPING_PROVIDER_NAME=manual
SHIPPING_PROVIDER_URL=
SHIPPING_PROVIDER_TOKEN=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
RETURN_WINDOW_DAYS=30
