generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AppRole {
  CUSTOMER          @map("customer")
  ADMIN             @map("admin")
  CATALOGUE_MANAGER @map("catalogue_manager")
  WAREHOUSE_MANAGER @map("warehouse_manager")
  SUPPORT_AGENT     @map("support_agent")

  @@map("app_role")
}

enum ProductStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("product_status")
}

enum CartStatus {
  ACTIVE    @map("active")
  CONVERTED @map("converted")
  ABANDONED @map("abandoned")

  @@map("cart_status")
}

enum DiscountType {
  PERCENT @map("percent")
  FIXED   @map("fixed")

  @@map("discount_type")
}

enum ReservationStatus {
  ACTIVE   @map("active")
  RELEASED @map("released")
  CONSUMED @map("consumed")
  EXPIRED  @map("expired")

  @@map("reservation_status")
}

enum QuoteStatus {
  ACTIVE    @map("active")
  CONVERTED @map("converted")
  EXPIRED   @map("expired")

  @@map("quote_status")
}

enum StockMovementType {
  RECEIPT     @map("receipt")
  RESERVATION @map("reservation")
  RELEASE     @map("release")
  SALE        @map("sale")
  ADJUSTMENT  @map("adjustment")
  RETURN      @map("return")

  @@map("stock_movement_type")
}

enum OrderStatus {
  PAYMENT_PENDING @map("payment_pending")
  CONFIRMED       @map("confirmed")
  PAYMENT_FAILED  @map("payment_failed")
  CANCELLED       @map("cancelled")
  PROCESSING      @map("processing")
  SHIPPED         @map("shipped")
  DELIVERED       @map("delivered")

  @@map("order_status")
}

enum PaymentStatus {
  CREATED    @map("created")
  AUTHORIZED @map("authorized")
  CAPTURED   @map("captured")
  FAILED     @map("failed")
  REFUNDED   @map("refunded")

  @@map("payment_status")
}

enum WebhookStatus {
  RECEIVED   @map("received")
  PROCESSING @map("processing")
  PROCESSED  @map("processed")
  FAILED     @map("failed")

  @@map("webhook_status")
}

enum OutboxStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  PROCESSED  @map("processed")
  FAILED     @map("failed")

  @@map("outbox_status")
}

enum NotificationChannel {
  EMAIL    @map("email")
  SMS      @map("sms")
  WHATSAPP @map("whatsapp")

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING @map("pending")
  SENT    @map("sent")
  FAILED  @map("failed")

  @@map("notification_status")
}

enum ShipmentStatus {
  CREATED          @map("created")
  LABEL_CREATED    @map("label_created")
  IN_TRANSIT       @map("in_transit")
  OUT_FOR_DELIVERY @map("out_for_delivery")
  DELIVERED        @map("delivered")
  EXCEPTION        @map("exception")
  CANCELLED        @map("cancelled")

  @@map("shipment_status")
}

enum ReturnStatus {
  REQUESTED      @map("requested")
  APPROVED       @map("approved")
  REJECTED       @map("rejected")
  RECEIVED       @map("received")
  REFUND_PENDING @map("refund_pending")
  REFUNDED       @map("refunded")

  @@map("return_status")
}

enum RefundStatus {
  PENDING   @map("pending")
  PROCESSED @map("processed")
  FAILED    @map("failed")

  @@map("refund_status")
}

model Profile {
  id        String   @id @db.Uuid
  fullName  String?  @map("full_name")
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

model Role {
  name        AppRole @id
  description String?

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  role       AppRole
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@id([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String
  recipientName String   @map("recipient_name")
  phone         String
  line1         String
  line2         String?
  city          String
  state         String
  postalCode    String   @map("postal_code")
  country       String   @default("IN")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("addresses")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  name        String
  slug        String     @unique
  description String?
  isPublished Boolean    @default(false) @map("is_published")
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@index([isPublished, sortOrder])
  @@map("categories")
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  categoryId       String           @map("category_id") @db.Uuid
  name             String
  slug             String           @unique
  shortDescription String?          @map("short_description")
  description      String?
  material         String?
  status           ProductStatus    @default(DRAFT)
  attributes       Json             @default("{}")
  seoTitle         String?          @map("seo_title")
  seoDescription   String?          @map("seo_description")
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  images           ProductImage[]
  videos           ProductVideo[]

  @@index([categoryId])
  @@index([status, publishedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([shortDescription(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_short_description_trgm_idx")
  @@map("products")
}

model ProductVariant {
  id                  String                 @id @default(uuid()) @db.Uuid
  productId           String                 @map("product_id") @db.Uuid
  sku                 String                 @unique
  alias               String?
  pricePaise          Int                    @map("price_paise")
  compareAtPricePaise Int?                   @map("compare_at_price_paise")
  attributes          Json                   @default("{}")
  isActive            Boolean                @default(true) @map("is_active")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  product             Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLevels     InventoryLevel[]
  stockMovements      StockMovement[]
  cartItems           CartItem[]
  reservations        InventoryReservation[]
  imageLinks          ProductImageVariant[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id              String                @id @default(uuid()) @db.Uuid
  productId       String                @map("product_id") @db.Uuid
  altText         String                @map("alt_text")
  sortOrder       Int                   @default(0) @map("sort_order")
  sourceFilename  String                @map("source_filename")
  sourceMimeType  String                @map("source_mime_type")
  sourceWidth     Int                   @map("source_width")
  sourceHeight    Int                   @map("source_height")
  thumbnailPath   String                @unique @map("thumbnail_path")
  thumbnailUrl    String                @map("thumbnail_url")
  thumbnailWidth  Int                   @map("thumbnail_width")
  thumbnailHeight Int                   @map("thumbnail_height")
  thumbnailBytes  Int                   @map("thumbnail_bytes")
  mediumPath      String                @unique @map("medium_path")
  mediumUrl       String                @map("medium_url")
  mediumWidth     Int                   @map("medium_width")
  mediumHeight    Int                   @map("medium_height")
  mediumBytes     Int                   @map("medium_bytes")
  largePath       String                @unique @map("large_path")
  largeUrl        String                @map("large_url")
  largeWidth      Int                   @map("large_width")
  largeHeight     Int                   @map("large_height")
  largeBytes      Int                   @map("large_bytes")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantLinks    ProductImageVariant[]

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductImageVariant {
  imageId   String         @map("image_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  image     ProductImage   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([imageId, variantId])
  @@index([variantId, imageId])
  @@map("product_image_variants")
}

model ProductVideo {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  url            String
  storagePath    String?  @unique @map("storage_path")
  sourceFilename String?  @map("source_filename")
  sourceMimeType String?  @map("source_mime_type")
  altText        String   @map("alt_text")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_videos")
}

model Warehouse {
  id              String                 @id @default(uuid()) @db.Uuid
  code            String                 @unique
  name            String
  isActive        Boolean                @default(true) @map("is_active")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  inventoryLevels InventoryLevel[]
  stockMovements  StockMovement[]
  reservations    InventoryReservation[]

  @@map("warehouses")
}

model InventoryLevel {
  id                String         @id @default(uuid()) @db.Uuid
  warehouseId       String         @map("warehouse_id") @db.Uuid
  variantId         String         @map("variant_id") @db.Uuid
  onHand            Int            @default(0) @map("on_hand")
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(0) @map("low_stock_threshold")
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, variantId])
  @@index([variantId])
  @@map("inventory_levels")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  warehouseId   String            @map("warehouse_id") @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  type          StockMovementType
  quantity      Int
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  actorId       String?           @map("actor_id") @db.Uuid
  metadata      Json              @default("{}")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant       ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Cart {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String?                @map("user_id") @db.Uuid
  guestTokenHash String?                @unique @map("guest_token_hash")
  status         CartStatus             @default(ACTIVE)
  expiresAt      DateTime               @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  items          CartItem[]
  reservations   InventoryReservation[]
  quotes         CheckoutQuote[]

  @@index([userId, status])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Coupon {
  id                   String             @id @default(uuid()) @db.Uuid
  code                 String             @unique
  type                 DiscountType
  value                Int
  minimumSubtotalPaise Int                @default(0) @map("minimum_subtotal_paise")
  maximumDiscountPaise Int?               @map("maximum_discount_paise")
  usageLimit           Int?               @map("usage_limit")
  perUserLimit         Int?               @map("per_user_limit")
  startsAt             DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime           @map("ends_at") @db.Timestamptz(6)
  isActive             Boolean            @default(true) @map("is_active")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  redemptions          CouponRedemption[]
  quotes               CheckoutQuote[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model InventoryReservation {
  id          String            @id @default(uuid()) @db.Uuid
  cartId      String            @map("cart_id") @db.Uuid
  variantId   String            @map("variant_id") @db.Uuid
  warehouseId String            @map("warehouse_id") @db.Uuid
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart        Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([cartId, status])
  @@index([expiresAt, status])
  @@map("inventory_reservations")
}

model CheckoutQuote {
  id              String      @id @default(uuid()) @db.Uuid
  cartId          String      @map("cart_id") @db.Uuid
  userId          String?     @map("user_id") @db.Uuid
  couponId        String?     @map("coupon_id") @db.Uuid
  status          QuoteStatus @default(ACTIVE)
  currency        String      @default("INR")
  itemsSnapshot   Json        @map("items_snapshot")
  addressSnapshot Json        @map("address_snapshot")
  subtotalPaise   Int         @map("subtotal_paise")
  discountPaise   Int         @map("discount_paise")
  shippingPaise   Int         @map("shipping_paise")
  taxPaise        Int         @map("tax_paise")
  totalPaise      Int         @map("total_paise")
  expiresAt       DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  cart            Cart        @relation(fields: [cartId], references: [id], onDelete: Restrict)
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order           Order?

  @@index([cartId, status])
  @@index([expiresAt, status])
  @@map("checkout_quotes")
}

model Order {
  id               String          @id @default(uuid()) @db.Uuid
  orderNumber      String          @unique @map("order_number")
  quoteId          String          @unique @map("quote_id") @db.Uuid
  cartId           String          @map("cart_id") @db.Uuid
  userId           String?         @map("user_id") @db.Uuid
  couponId         String?         @map("coupon_id") @db.Uuid
  status           OrderStatus     @default(PAYMENT_PENDING)
  currency         String          @default("INR")
  itemsSnapshot    Json            @map("items_snapshot")
  addressSnapshot  Json            @map("address_snapshot")
  subtotalPaise    Int             @map("subtotal_paise")
  discountPaise    Int             @map("discount_paise")
  shippingPaise    Int             @map("shipping_paise")
  taxPaise         Int             @map("tax_paise")
  totalPaise       Int             @map("total_paise")
  hdfcOrderId      String?         @unique @map("hdfc_order_id")
  paymentExpiresAt DateTime        @map("payment_expires_at") @db.Timestamptz(6)
  confirmedAt      DateTime?       @map("confirmed_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  quote            CheckoutQuote   @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  payments         Payment[]
  invoice          Invoice?
  notifications    Notification[]
  shipments        Shipment[]
  returns          ReturnRequest[]

  @@index([userId, createdAt])
  @@index([status, paymentExpiresAt])
  @@index([cartId, status, paymentExpiresAt])
  @@index([orderNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_order_number_trgm_idx")
  @@map("orders")
}

model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  number      String   @unique
  storagePath String   @unique @map("storage_path")
  bytes       Int
  sha256      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@map("invoices")
}

model OutboxEvent {
  id                  String       @id @default(uuid()) @db.Uuid
  aggregateType       String       @map("aggregate_type")
  aggregateId         String       @map("aggregate_id")
  eventType           String       @map("event_type")
  dedupeKey           String       @unique @map("dedupe_key")
  payload             Json
  status              OutboxStatus @default(PENDING)
  attempts            Int          @default(0)
  availableAt         DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  processingStartedAt DateTime?    @map("processing_started_at") @db.Timestamptz(6)
  lastError           String?      @map("last_error")
  processedAt         DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_events")
}

model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  orderId       String              @map("order_id") @db.Uuid
  outboxEventId String              @map("outbox_event_id") @db.Uuid
  channel       NotificationChannel
  recipient     String
  template      String
  status        NotificationStatus  @default(PENDING)
  attempts      Int                 @default(0)
  providerRef   String?             @map("provider_ref")
  lastError     String?             @map("last_error")
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([outboxEventId, channel, recipient])
  @@index([orderId, status])
  @@map("notifications")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  hdfcTransactionId String?       @unique @map("hdfc_transaction_id")
  status            PaymentStatus
  amountPaise       Int           @map("amount_paise")
  currency          String        @default("INR")
  signatureVerified Boolean       @default(false) @map("signature_verified")
  method            String?
  capturedAt        DateTime?     @map("captured_at") @db.Timestamptz(6)
  rawPayload        Json          @default("{}") @map("raw_payload")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds           Refund[]

  @@index([orderId, status])
  @@map("payments")
}

model Shipment {
  id                 String          @id @default(uuid()) @db.Uuid
  orderId            String          @map("order_id") @db.Uuid
  provider           String
  providerShipmentId String?         @unique @map("provider_shipment_id")
  trackingNumber     String?         @unique @map("tracking_number")
  carrier            String?
  status             ShipmentStatus  @default(CREATED)
  addressSnapshot    Json            @map("address_snapshot")
  shippedAt          DateTime?       @map("shipped_at") @db.Timestamptz(6)
  deliveredAt        DateTime?       @map("delivered_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items              ShipmentItem[]
  events             TrackingEvent[]

  @@index([orderId, status])
  @@map("shipments")
}

model ShipmentItem {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  sku        String
  quantity   Int
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_items")
}

model TrackingEvent {
  id              String         @id @default(uuid()) @db.Uuid
  shipmentId      String         @map("shipment_id") @db.Uuid
  providerEventId String         @map("provider_event_id")
  status          ShipmentStatus
  message         String?
  location        String?
  occurredAt      DateTime       @map("occurred_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, providerEventId])
  @@index([shipmentId, occurredAt])
  @@map("tracking_events")
}

model ReturnRequest {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  status        ReturnStatus @default(REQUESTED)
  reason        String
  reviewNote    String?      @map("review_note")
  eligibleUntil DateTime     @map("eligible_until") @db.Timestamptz(6)
  reviewedBy    String?      @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  receivedAt    DateTime?    @map("received_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds       Refund[]

  @@index([orderId, status])
  @@index([userId, createdAt])
  @@map("return_requests")
}

model Refund {
  id              String         @id @default(uuid()) @db.Uuid
  paymentId       String         @map("payment_id") @db.Uuid
  returnRequestId String?        @map("return_request_id") @db.Uuid
  idempotencyKey  String         @unique @map("idempotency_key")
  hdfcRefundId    String?        @unique @map("hdfc_refund_id")
  amountPaise     Int            @map("amount_paise")
  currency        String         @default("INR")
  status          RefundStatus   @default(PENDING)
  reason          String?
  rawPayload      Json           @default("{}") @map("raw_payload")
  processedAt     DateTime?      @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  payment         Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)

  @@index([paymentId, status])
  @@map("refunds")
}

/// Razorpay ids of orders/payments/refunds made before HDFC SmartGateway; history only.
model LegacyRazorpayReference {
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  razorpayId String   @map("razorpay_id")
  archivedAt DateTime @default(now()) @map("archived_at") @db.Timestamptz(6)

  @@id([entityType, entityId])
  @@map("legacy_razorpay_references")
}

model WebhookEvent {
  id                  String        @id @default(uuid()) @db.Uuid
  providerEventId     String        @unique @map("provider_event_id")
  eventType           String        @map("event_type")
  status              WebhookStatus @default(RECEIVED)
  payload             Json
  attempts            Int           @default(0)
  processingStartedAt DateTime?     @map("processing_started_at") @db.Timestamptz(6)
  lastError           String?       @map("last_error")
  processedAt         DateTime?     @map("processed_at") @db.Timestamptz(6)
  receivedAt          DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([status, receivedAt])
  @@map("webhook_events")
}
